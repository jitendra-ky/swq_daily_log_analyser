# Django Secret Key (Generate a random string for production)
SECRET_KEY=your-secret-key-here

# Debug mode (Set to False in production)
DEBUG=True

# Comma-separated list of allowed hosts (e.g., your-app.onrender.com,localhost,127.0.0.1)
ALLOWED_HOSTS=127.0.0.1,localhost

# Enable or disable allowing all CORS origins (Set to False in production)
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of allowed CORS origins (if CORS_ALLOW_ALL_ORIGINS is False)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Your Groq API Key
GROQ_API_KEY=your-groq-api-key-here
